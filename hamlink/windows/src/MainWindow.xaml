<Window x:Class="HamLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HamLink" Width="880" Height="660" MinWidth="620" MinHeight="420"
        Closing="OnClosing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Help" Padding="14,5" Margin="0,0,8,0" Click="OnHelp"
                        ToolTip="Equipment for each modem, offline maps, troubleshooting" />
                <Button x:Name="SettingsBtn" Content="Settings" Padding="14,5" Margin="0,0,8,0" Click="OnSettings" />
                <Button x:Name="TestBtn" Content="Test / Calibrate" Padding="14,5" Margin="0,0,8,0" Click="OnTest" />
                <Button x:Name="StartBtn" Content="Start" Padding="20,5" Click="OnStartStop" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="CallText" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="RouteText" Foreground="Gray" />
                <TextBlock x:Name="PttText" Foreground="Gray" />
                <TextBlock x:Name="ModeText" Foreground="SteelBlue" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <RadioButton x:Name="ViewMsgBtn" Content="Messages" GroupName="view" IsChecked="True" Margin="0,0,14,0" Checked="OnViewChanged" />
                    <RadioButton x:Name="ViewMapBtn" Content="Map" GroupName="view" Margin="0,0,14,0" Checked="OnViewChanged" />
                    <RadioButton x:Name="ViewStationsBtn" Content="Stations" GroupName="view" Checked="OnViewChanged"
                                 ToolTip="Messages one station at a time" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- status row -->
        <DockPanel Grid.Row="1" Margin="0,10">
 <StackPanel x:Name="ModemPanel" DockPanel.Dock="Right" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Modem:" Margin="0,0,6,0" VerticalAlignment="Center" />
                <RadioButton x:Name="ModemAfskBtn" Content="AFSK 1200" GroupName="modem" Margin="0,0,8,0" Checked="OnModemChanged" />
                <RadioButton x:Name="ModemOfdmBtn" Content="OFDM" GroupName="modem" Margin="0,0,8,0" Checked="OnModemChanged" />
                <RadioButton x:Name="ModemMt63Btn" Content="MT63-2000" GroupName="modem" Margin="0,0,8,0" Checked="OnModemChanged"
                             ToolTip="MT63-2000: slow but robust. About 7x the airtime of AFSK, but decodes far weaker, noisier signals." />
                <RadioButton x:Name="ModemPsk2400Btn" Content="PSK 2400" GroupName="modem" Margin="0,0,8,0" Checked="OnModemChanged"
                             ToolTip="PSK 2400 (QPSK): about twice the throughput of AFSK, about as robust." />
                <RadioButton x:Name="ModemPsk3600Btn" Content="PSK 3600" GroupName="modem" Checked="OnModemChanged"
                             ToolTip="PSK 3600 (8-PSK): fastest, about 2.4x AFSK, but needs a strong, clean signal." />
            </StackPanel>
            <CheckBox x:Name="RelayBox" DockPanel.Dock="Right" Content="Relay mode" VerticalAlignment="Center"
                      Margin="14,0,0,0" Checked="OnRelayChanged" Unchecked="OnRelayChanged" />
            <Border x:Name="PhaseBadge" DockPanel.Dock="Left" Background="Gray" Padding="10,3" Margin="0,0,14,0">
                <TextBlock x:Name="PhaseText" Foreground="White" FontWeight="SemiBold" Text="OFF" />
            </Border>
            <ProgressBar x:Name="LevelBar" Minimum="0" Maximum="1" Height="14" />
        </DockPanel>

        <!-- log -->
        <ListBox x:Name="LogList" Grid.Row="2" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,2">
                        <Button DockPanel.Dock="Right" Content="Play" Padding="10,1" Margin="8,0,0,0"
                                Visibility="{Binding PlayVisibility}" Tag="{Binding}" Click="OnPlayClip" />
                        <TextBlock Text="{Binding Display}" Foreground="{Binding Brush}" TextWrapping="Wrap" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- manual PTT: you key the radio when the countdown says so. Bottom row, below the map too, so positions and
             reports sent from the Map view can be transmitted without switching back to Messages -->
        <Border x:Name="ManualPanel" Grid.Row="4" Visibility="Collapsed" Background="#FFF3E0" BorderBrush="DarkOrange"
                BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock x:Name="ManualText" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="ManualGoBtn" Content="Transmit" Padding="18,5" Margin="0,0,8,0" Click="OnManualGo" />
                    <Button Content="Cancel" Padding="14,5" Click="OnManualCancel" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- compose -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="To" FontSize="11" Foreground="Gray" />
                <TextBox x:Name="DestBox" Width="100" MaxLength="8" CharacterCasing="Upper" Padding="3" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Message (Enter to send)" FontSize="11" Foreground="Gray" />
                <TextBox x:Name="MsgBox" Padding="3" KeyDown="OnMsgKeyDown" />
            </StackPanel>
            <Button x:Name="SendBtn" Grid.Column="2" Content="Send text" Padding="16,6" Margin="0,14,8,0"
                    VerticalAlignment="Bottom" Click="OnSendText" />
            <Button x:Name="TalkBtn" Grid.Column="3" Content="Hold to record voice" Padding="16,6" Margin="0,14,0,0"
                    VerticalAlignment="Bottom" MinWidth="170"
                    PreviewMouseLeftButtonDown="OnTalkDown" PreviewMouseLeftButtonUp="OnTalkUp" LostMouseCapture="OnTalkLost" />
        </Grid>

        <!-- stations view: covers the log only; the compose row below stays, addressed to the selected station -->
        <Border x:Name="StationsHost" Grid.Row="2" Background="White" Visibility="Collapsed" />
        <!-- map view: covers the log and compose rows (not the manual PTT panel) when "Map" is selected -->
        <Border x:Name="MapHost" Grid.Row="2" Grid.RowSpan="2" Background="White" Visibility="Collapsed" />
    </Grid>
</Window>
