# HamLink relay service. Installed by hamlink/pi/install.sh to /etc/systemd/system/.
[Unit]
Description=HamLink relay
After=sound.target bluetooth.target network.target
Wants=bluetooth.target

[Service]
Type=notify
User=hamlink
Group=hamlink
ExecStart=/usr/local/bin/hamlinkd --state-dir /var/lib/hamlink
Restart=always
RestartSec=5
# The service tells systemd it is alive every 2 s; if the radio loop stalls for 30 s, systemd restarts it.
WatchdogSec=30
# Ahead of other programs, so audio is not starved; the modems need about 1-3% of one core.
Nice=-5
StateDirectory=hamlink
# The web page on port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=full
ReadWritePaths=/etc/hamlink
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
