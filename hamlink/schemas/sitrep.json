{
  "schema": 3,
  "version": 2,
  "name": "SITREP",
  "title": "Station SITREP",
  "map": {
    "role": "none",
    "label": "{cond} / {pos}"
  },
  "fields": [
    {"key": "cond", "label": "1. Conditions at operator's location", "kind": "enum", "values": [
      {"code": 0, "name": "A: all stable"},
      {"code": 1, "name": "B: moderate disruptions"},
      {"code": 2, "name": "C: severe disruptions"}
    ]},
    {"key": "pos", "label": "2. Operator's position", "kind": "enum", "values": [
      {"code": 0, "name": "H: home"},
      {"code": 1, "name": "M: mobile"},
      {"code": 2, "name": "P: portable"}
    ]},
    {"key": "power", "label": "3. Commercial power", "kind": "enum", "optional": true, "values": [
      {"code": 0, "name": "Y: yes"}, {"code": 1, "name": "I: intermittent"}, {"code": 2, "name": "N: no"}
    ]},
    {"key": "water", "label": "4. Water", "kind": "enum", "optional": true, "values": [
      {"code": 0, "name": "Y: yes"}, {"code": 1, "name": "C: contaminated"}, {"code": 2, "name": "N: no"}
    ]},
    {"key": "sanitation", "label": "5. Sanitation", "kind": "enum", "optional": true, "values": [
      {"code": 0, "name": "Y: yes"}, {"code": 1, "name": "N: no"}
    ]},
    {"key": "medical", "label": "6. Medical", "kind": "enum", "optional": true, "values": [
      {"code": 0, "name": "Y: yes"}, {"code": 1, "name": "N: no"}
    ]},
    {"key": "comms", "label": "7. Grid communications", "kind": "enum", "optional": true, "values": [
      {"code": 0, "name": "Y: yes"}, {"code": 1, "name": "N: no"}
    ]},
    {"key": "transport", "label": "8. Transportation", "kind": "enum", "optional": true, "values": [
      {"code": 0, "name": "Y: yes"}, {"code": 1, "name": "N: no"}
    ]}
  ]
}
